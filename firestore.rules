rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Public website content: readable by everyone, editable only after Firebase login.
    match /services/{id}       { allow read: if true; allow write: if signedIn(); }
    match /categories/{id}     { allow read: if true; allow write: if signedIn(); }
    match /updates/{id}        { allow read: if true; allow write: if signedIn(); }
    match /notifications/{id}  { allow read: if true; allow write: if signedIn(); }
    match /images/{id}         { allow read: if true; allow write: if signedIn(); }
    match /documents/{id}      { allow read: if true; allow write: if signedIn(); }
    match /youtube/{id}        { allow read: if true; allow write: if signedIn(); }
    match /settings/{id}       { allow read: if true; allow write: if signedIn(); }

    // Basic anonymous visitor counters used by the public website.
    match /analytics/{id} {
      allow read: if signedIn();
      allow create, update: if true;
      allow delete: if signedIn();
    }
    match /visitorDaily/{id} {
      allow read: if signedIn();
      allow create, update: if true;
      allow delete: if signedIn();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }

    match /pageContent/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }
}
